# ─── Rails ────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 64
SECRET_KEY_BASE=REEMPLAZAR_CON_HEX_LARGO

# Generar con: docker compose run --rm rails rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false

FRONTEND_URL=https://chat.capitalplus.mx

# ─── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO
POSTGRES_DATABASE=chatwoot_production
RAILS_MAX_THREADS=5

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO

# ─── Email (usa tu proveedor SMTP: Gmail, Mailgun, SendGrid, etc.) ────────────
MAILER_SENDER_EMAIL=Capital Plus <no-reply@capitalplus.mx>
SMTP_DOMAIN=capitalplus.mx
SMTP_ADDRESS=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# ─── Almacenamiento ───────────────────────────────────────────────────────────
# "local" guarda en el servidor (volumen Docker)
# "amazon" usa S3 (recomendado para backups automáticos)
ACTIVE_STORAGE_SERVICE=local

# Si usas S3:
# ACTIVE_STORAGE_SERVICE=amazon
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# Token global definido en tu código (feature multi-número)
# Asegúrate que coincida con lo configurado en Meta Business Manager

# ─── Facebook / Instagram (si aplica) ────────────────────────────────────────
FB_VERIFY_TOKEN=
FB_APP_SECRET=
FB_APP_ID=
IG_VERIFY_TOKEN=

# ─── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_SIZE=500

# ─── Sidekiq ──────────────────────────────────────────────────────────────────
SIDEKIQ_CONCURRENCY=5
