<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Tabla de amortización</title>
<style>
:root {
  --green:#132a17;
  --gold:#d8ba7d;
  --row:#efefec;
  --ink:#1a241c;
  --line:#353c36;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{background:#ffffff;font-family:Arial,Helvetica,sans-serif;color:var(--ink);font-size:11px}

.header{
  background:var(--green);
  color:white;
  display:flex;
  align-items:center;
  gap:24px;
  padding:18px 36px;
}
.header img{display:block;width:130px;height:65px;object-fit:contain}
.header-title{font-size:18px;font-weight:700;color:white}
.header-subtitle{font-size:12px;color:var(--gold);margin-top:2px}

.summary{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px 24px;
  padding:16px 36px;
  background:var(--row);
  border-bottom:1.4px solid var(--line);
}
.summary .field label{display:block;font-size:9px;color:#6b736c;text-transform:uppercase;letter-spacing:.03em}
.summary .field .value{font-size:13px;font-weight:700}

table{width:100%;border-collapse:collapse;margin:0 auto}
thead{display:table-header-group;background:var(--green)}
th{color:white;text-align:right;padding:8px 12px;font-size:10px;text-transform:uppercase}
th:nth-child(1),th:nth-child(2){text-align:left}
td{padding:5px 12px;text-align:right;border-bottom:1px solid #e2e2de}
td:nth-child(1),td:nth-child(2){text-align:left}
tbody tr:nth-child(odd){background:var(--row)}
tr{page-break-inside:avoid}
tfoot td{font-weight:700;border-top:1.4px solid var(--line);border-bottom:none;padding-top:8px}

.footer{
  margin-top:18px;
  padding:14px 36px;
  background:var(--green);
  color:white;
  text-align:center;
  font-size:11px;
}
.footer b{color:var(--gold)}

@media print{
  .header,.footer{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  thead{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
</style>
</head>
<body>

<header class="header">
  <img src="data:image/png;base64," alt="Fuego">
  <div>
    <div class="header-title">Tabla de amortización</div>
    <div class="header-subtitle"><%= lote %> &middot; <%= desarrollo %></div>
  </div>
</header>

<section class="summary">
  <div class="field"><label>Cliente</label><span class="value"><%= nombre %></span></div>
  <div class="field"><label>Superficie</label><span class="value"><%= superficie %> m&sup2;</span></div>
  <div class="field"><label>Precio m&sup2;</label><span class="value"><%= precio_m2 %></span></div>
  <div class="field"><label>Importe</label><span class="value"><%= importe %></span></div>
  <div class="field"><label>Enganche</label><span class="value"><%= enganche_pct %>%</span></div>
  <div class="field"><label>Interés</label><span class="value"><%= interes_pct %>%</span></div>
  <div class="field"><label>Plazo</label><span class="value"><%= plazos %> meses</span></div>
  <div class="field"><label>Pago mensual</label><span class="value"><%= pago_mensual %></span></div>
</section>

<table>
  <thead>
    <tr>
      <th>Periodo</th><th>Fecha</th><th>Saldo inicial</th><th>Interés</th><th>Capital</th><th>Pago</th><th>Saldo final</th>
    </tr>
  </thead>
  <tbody>
    <% schedule.each do |row| %>
      <tr>
        <td>Mes <%= row[:periodo] %></td>
        <td><%= row[:fecha] %></td>
        <td><%= row[:saldo_inicial] %></td>
        <td><%= row[:interes] %></td>
        <td><%= row[:capital] %></td>
        <td><%= row[:pago] %></td>
        <td><%= row[:saldo_final] %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="5"></td>
      <td>Total</td>
      <td><%= total %></td>
    </tr>
  </tfoot>
</table>

<footer class="footer">
  Enviar comprobantes de pago a&nbsp;<b>cobranza@fuegocancun.com</b>
</footer>
</body>
</html>
